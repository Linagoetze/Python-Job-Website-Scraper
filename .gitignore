.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.DS_Store
*.log

# Machine-local Claude Code permissions (contains absolute paths).
.claude/settings.local.json

# Generated output.
data/*.csv
data/*.xlsx

# Your personal search config. The .example versions are the tracked templates.
job_scraper/config/sources.yaml
job_scraper/config/rules.json

# Hand-maintained personal data. Everything under curated/ is local by default
# and only the .example templates are tracked, rather than naming each real
# file: the per-file list missed `excluded_sources.numbers` the moment Numbers
# saved a copy of the CSV beside it, and a `git add -A` staged it (CU2). A rule
# that has to be extended every time an application writes a sidecar is a rule
# that will be wrong again.
data/curated/*
!data/curated/*.example.csv
!data/curated/*.example.xlsx

# Pre-publish backup of the original repo history (local only).
.git.backup/
data/*.db
data/*.sqlite3
data/*.sqlite
# SQLite WAL sidecars (jobs.sqlite3-wal / -shm) hold the same personal data as
# the database itself and are not matched by the patterns above.
data/*.db-*
data/*.sqlite3-*
job_scraper/config/profile.md

# Hand-labelled gold set for the offline evaluation harness (WP8c). Real
# titles and companies; the harness reads it, nothing regenerates it.
data/curated/labels.csv
